.worktrees/
.env

# Python development and build outputs.
.venv/
.wheel-venv/
.wheel-smoke/
.ci-evidence/
dist/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Agent skills, restored from the pin in skills-lock.json rather than vendored.
# See docs/agents/skills.md.
.agents/skills/

# Local list of names, hostnames and device IDs that must never be committed.
# See AGENTS.md.
.pii-denylist

# Frigate: real values and rendered output. Only the template front-door/frigate/config.yaml is committed.
front-door/frigate/*.local.yaml
front-door/frigate/build/

# Displays and other household config: real overlays and rendered output.
dashboards/**/*.local.yaml
dashboards/**/build/

# Private discovery notes about the live instance: real names and entity IDs. Never committed.
.private/
